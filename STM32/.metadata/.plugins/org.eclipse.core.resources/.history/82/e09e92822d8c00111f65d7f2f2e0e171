#include "main.h"
#include "BMP280.h"
#inlcude "string.h"
extern UART_HandleTypeDef huart2;

extern I2C_HandleTypeDef hi2c1;

char txBuffer[50];
uint8_t address;

HAL_UART_Transmit(&huart2, (uint8_t *)"Scanning I2C...\r\n", 18, HAL_MAX_DELAY);

for (address = 1; address < 128; address++)
{
    if (HAL_I2C_IsDeviceReady(&hi2c1, address << 1, 3, 100) == HAL_OK)
    {
        sprintf(txBuffer, "Found device at 0x%02X\r\n", address);
        HAL_UART_Transmit(&huart2,
                          (uint8_t *)txBuffer,
                          strlen(txBuffer),
                          HAL_MAX_DELAY);
        HAL_Delay(1000);  // Optional delay to avoid flooding the UART
    }
}

HAL_UART_Transmit(&huart2, (uint8_t *)"Scan complete.\r\n", 16, HAL_MAX_DELAY);
HAL_Delay(1000);  // Optional delay before the next scan

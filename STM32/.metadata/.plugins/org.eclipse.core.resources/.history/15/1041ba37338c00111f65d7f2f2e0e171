#include "main.h"
#include "BMP280.h"
#include "string.h"
#include "stdio.h"

extern I2C_HandleTypeDef hi2c1;
extern UART_HandleTypeDef huart2;

uint8_t BMP280_FindAddress(void)
{
	uint8_t address =1;
	uint8_t bmp280_address = 0x00;	for(address = 1; address <= 128 ; address++)	{		if(HAL_I2C_IsDeviceReady(&hi2c1, (address << 1), 3, 100) == HAL_OK)		{
			return address;		}	}
	return 0x00;
}

#include "main.h"
#include "BMP280.h"
#include "string.h"
#include "stdio.h"

extern I2C_HandleTypeDef hi2c1;
extern UART_HandleTypeDef huart2;

void BMP280_FindAddress(void)
{
	uint8_t address =0x0;
	uint8_t bmp280_address = 0x00;	for(address = 0x0 ; address <= 0x7F ; address++)	{		if(HAL_I2C_IsDeviceReady(&hi2c1, (address << 1), 3, 100) == HAL_OK)		{
			bmp280_address = address;			break;		}	}
	if(bmp280_address == 0x00)
	{
		// BMP280 not found
		return 0x00;
	}
	else
	{
		uint8_t uart_buffer[50];
		sprintf((char*)uart_buffer, "BMP280 Address: 0x%02X\r\n", bmp280_address);
		HAL_UART_Transmit(&huart2, uart_buffer, strlen((char*)uart_buffer), HAL_MAX_DELAY);
	}

}

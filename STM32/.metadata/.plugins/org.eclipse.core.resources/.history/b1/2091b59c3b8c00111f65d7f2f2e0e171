#include "main.h"
#include "BMP280.h"
#include "string.h"
#include "stdio.h"

extern I2C_HandleTypeDef hi2c1;
extern UART_HandleTypeDef huart2;

uint8_t BMP280_FindAddress(void)
{
	if(HAL_I2C_IsDeviceReady(&hi2c1, (0x76 << 1), 3, 100) == HAL_OK)
	{
		return 0x76;
	}
	return 0x00;
}

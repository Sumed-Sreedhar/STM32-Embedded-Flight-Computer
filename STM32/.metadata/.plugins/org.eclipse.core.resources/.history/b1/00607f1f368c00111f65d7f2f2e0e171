#include "main.h"
#include "led.h"
#include "system_state.h"
#include "system_health.h"
#include "BMP280.h"

volatile system_state_t current_system_state = BOOTING;

void handle_system_state(void) {
	switch(current_system_state)
	{
	case BOOTING:
		led_status_blink_slow();
		break;
	case SELF_TEST:
		led_status_blink_fast();
		break;
	case ACTIVE:
		led_status_on();
		break;
	default:
		current_health_state = CRITICAL_FAULT;
		break;
	}
}

uint8_t BMP280_TEST(void)
{
	uint8_t address = 1;
	for(address = 1; address < 128 ; address++)
	{
		if(HAL_I2C_IsDeviceReady(&hi2c1, (address << 1), 3, 100) == HAL_OK)
		{
			return address;
		}
	}
	return 0x00;
}

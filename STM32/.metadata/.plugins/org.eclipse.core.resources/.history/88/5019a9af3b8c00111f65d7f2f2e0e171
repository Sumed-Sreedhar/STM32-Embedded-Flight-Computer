#include "main.h"
#include "BMP280.h"
#include "string.h"
#include "stdio.h"

extern I2C_HandleTypeDef hi2c1;
extern UART_HandleTypeDef huart2;

#define BMP280_ADDRESS (0x76 << 1)

uint8_t BMP280_FindAddress(void)
{
	if(HAL_I2C_IsDeviceReady(&hi2c1, BMP280_ADDRESS, 3, 100) == HAL_OK)
	{
		return 0x76;
	}
	return 0x00;
}

void BMP280_Init(void)
{
	uint8_t ctrl_meas = 0b01001111;
	HAL_I2C_Write(&hi2c1, BMP280_ADDRESS, 0xF4, 1, ctrl_meas, 1, 100);

	uint8_t config = 0b00001000;
	HAL_I2C_Write(&hi2c1, BMP280_ADDRESS, 0xF45, 1, config, 1, 100);
}
















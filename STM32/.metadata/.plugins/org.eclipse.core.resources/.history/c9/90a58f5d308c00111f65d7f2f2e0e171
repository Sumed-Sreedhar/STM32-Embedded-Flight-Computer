#include "main.h"
#include "BMP280.h"
#include "string.h"

extern I2C_HandleTypeDef hi2c1;

uint8_t BMP280_FindAddress(void)
{
	uint8_t address =0x0;	for(address = 0x0 ; address <= 0x7F ; address++)	{		if(HAL_I2C_IsDeviceReady(&hi2c1, (address << 1), 3, 100) == HAL_OK)		{
			return address;		}	}
	return 0x0;

}

#include "main.h"
#include "led.h"
#include "system_state.h"
#include "system_health.h"
#include "BMP280.h"

volatile system_state_t current_system_state = BOOTING;

void handle_system_state(void) {
	switch(current_system_state)
	{
	case BOOTING:
		led_status_blink_slow();
		break;
	case SELF_TEST:
		led_status_blink_fast();
		break;
	case ACTIVE:
		led_status_on();
		break;
	default:
		current_health_state = CRITICAL_FAULT;
		break;
	}
}

void BMP280_SelfTest(void)
{
	if(BMP280_FindAddress() == 0x76)
	{
		if(BMP280_Init() == HAL_OK)
		{
			current_health_state = NORMAL;
		}
		else
		{
			current_health_state = FAULT;
		}
		//BMP280_LoadCalibration();

	}
	else
	{
		current_health_state = CRITICAL_FAULT;
	}
}

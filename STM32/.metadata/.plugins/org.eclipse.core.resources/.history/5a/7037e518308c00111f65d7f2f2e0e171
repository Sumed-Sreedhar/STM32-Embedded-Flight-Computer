#include "main.h"
#include "BMP280.h"
#include "string.h"

uint8_t BMP280_FindAddress(void)
{
	uint8_t address =0x0;
	uint8_t i2c_address = 0x0;	for(address = 0x0 ; address <= 0x7F ; address++)	{		if(HAL_I2C_IsDeviceReady(&hi2c1, (address << 1), 3, 100) == HAL_OK)		{			i2c_address = address;
			break;		}	}
	sprintf((char *)i2c_address, "0x%02X", i2c_address);
	HAL_UART_Transmit(&huart2, (char *)i2c_address, strlen(i2c_address), HAL_MAX_DELAY);}

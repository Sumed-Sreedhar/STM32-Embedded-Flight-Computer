#include "led.h"
#include "main.h"


static uint32_t last_status_blink_time = 0;
static uint32_t last_fault_blink_time = 0;

void led_status_on(void)
{
	HAL_GPIO_WritePin(STATUS_LED_GPIO_Port,STATUS_LED_Pin, GPIO_PIN_SET);
}

void led_status_off(void){	HAL_GPIO_WritePin(STATUS_LED_GPIO_Port,STATUS_LED_Pin, GPIO_PIN_RESET);}

void led_status_blink_slow(void)
{
	uint32_t status_last_blink;
	status_last_blink = HAL_GetTick() - last_status_blink_time;
	if(status_last_blink >= 1000)
	{
		HAL_GPIO_TogglePin(STATUS_LED_GPIO_Port,STATUS_LED_Pin);
		last_status_blink_time = HAL_GetTick();

	}
}

void led_status_blink_fast(void)
{
	uint32_t status_last_blink;
	status_last_blink = HAL_GetTick() - last_status_blink_time;
	if(status_last_blink >= 250)
	{
		HAL_GPIO_TogglePin(STATUS_LED_GPIO_Port,STATUS_LED_Pin);
		last_status_blink_time = HAL_GetTick();

	}
}

void led_fault_on(void){	HAL_GPIO_WritePin(FAULT_LED_GPIO_Port,FAULT_LED_Pin, GPIO_PIN_SET);}

void led_fault_off(void){	HAL_GPIO_WritePin(FAULT_LED_GPIO_Port,FAULT_LED_Pin, GPIO_PIN_RESET);}

void led_fault_blink(void)
{
	uint32_t fault_last_blink;
	fault_last_blink = HAL_GetTick() - last_fault_blink_time;
	if(fault_last_blink >= 250)
	{
		HAL_GPIO_TogglePin(FAULT_LED_GPIO_Port,FAULT_LED_Pin);
		last_fault_blink_time = HAL_GetTick();

	}
}

void led_normal_on(void){	HAL_GPIO_WritePin(NORMAL_LED_GPIO_Port,NORMAL_LED_Pin, GPIO_PIN_SET);}

void led_normal_off(void){	HAL_GPIO_WritePin(NORMAL_LED_GPIO_Port,NORMAL_LED_Pin, GPIO_PIN_RESET);}
